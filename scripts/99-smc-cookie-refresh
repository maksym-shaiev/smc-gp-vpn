#!/usr/bin/env python3
"""
99-smc-cookie-refresh — NM dispatcher script.

NetworkManager calls dispatcher scripts as:
    <script> <interface> <action>

with environment variables CONNECTION_UUID, CONNECTION_ID, etc.

Strategy: when one of the configured VPN endpoints goes down, mint a fresh
gateway cookie (using the still-valid portal-userauthcookie from that
endpoint's cache) and write it back to the NM profile so the next toggle-on
works without user intervention.

If the portal session has also expired (browser login required), send
a desktop notification and exit cleanly — the toggle-on will fail and
the user must run `smc-vpn-refresh` manually.

NM waits for dispatcher scripts on vpn-pre-up/pre-down but NOT on
vpn-down. This script runs in the background on vpn-down (no-wait
semantics). That is fine: we only need to finish before the next
manual toggle-on attempt.

Configuration is read from ~/.config/smc-gp-vpn/config, written by
install.sh. All previously hardcoded values (username, UID, portal,
connection name) are derived at runtime. Multiple endpoints
(ENDPOINTS / ENDPOINT_<ID>_* keys) are supported: the endpoint whose
NM connection went down is refreshed; unknown connections are ignored.
"""

import os
import sys
import glob
import json
import shutil
import subprocess
import syslog
import gi

gi.require_version("NM", "1.0")
from gi.repository import NM, GLib  # noqa: E402

# ── config ───────────────────────────────────────────────────────────────────

def load_config(path: str) -> dict:
    config = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, value = line.partition("=")
                config[key.strip()] = os.path.expanduser(value.strip())
    except FileNotFoundError:
        pass
    return config


def find_config() -> tuple[str, dict]:
    """
    Find the config file for the invoking user.

    The dispatcher runs as root. We locate the config by iterating
    over active login sessions (via /run/user/<uid>/bus) and checking
    which user owns a smc-gp-vpn config.
    """
    for bus_path in glob.glob("/run/user/*/bus"):
        uid = int(bus_path.split("/")[3])
        try:
            pw = __import__("pwd").getpwuid(uid)
        except KeyError:
            continue
        config_path = os.path.join(pw.pw_dir, ".config", "smc-gp-vpn", "config")
        if os.path.exists(config_path):
            return config_path, load_config(config_path), pw
    return "", {}, None


def as_gateway_flag(config: dict, eid: str) -> bool:
    """True when ENDPOINT_<ID>_AS_GATEWAY enables gateway-mode auth."""
    return config.get(f"ENDPOINT_{eid}_AS_GATEWAY", "").strip().lower() in (
        "1", "yes", "true", "y", "on",
    )


def parse_endpoints(config: dict, home_dir: str) -> list[dict]:
    """Parse ENDPOINT_* entries from config; fall back to legacy single-endpoint keys.

    Mirrors parse_endpoints() in smc-vpn-refresh / nm-profile-setup.py.
    Each endpoint is a dict: {id, portal, conn_name, cache, as_gateway}.
    home_dir is the invoking user's home (the dispatcher runs as root, so
    ~ is /root).
    """
    endpoints: list[dict] = []
    for eid in (s.strip().upper() for s in config.get("ENDPOINTS", "").split(",")):
        if not eid or not eid.replace("_", "").isalnum():
            continue
        portal = config.get(f"ENDPOINT_{eid}_PORTAL", "")
        conn = config.get(f"ENDPOINT_{eid}_CONN_NAME", "")
        if not portal or not conn:
            continue
        cache = config.get(
            f"ENDPOINT_{eid}_CACHE",
            os.path.join(home_dir, f".config/gpclient/smc-cookie-{eid.lower()}.json"),
        )
        endpoints.append({
            "id": eid,
            "portal": portal,
            "conn_name": conn,
            "cache": cache,
            "as_gateway": as_gateway_flag(config, eid),
        })

    if endpoints:
        return endpoints

    # Legacy single-endpoint config (written by older install.sh versions).
    portal = config.get("PORTAL", "")
    if portal:
        return [{
            "id": "MAIN",
            "portal": portal,
            "conn_name": config.get("CONN_NAME", "SMC"),
            "cache": config.get("CACHE", ""),
            "as_gateway": False,
        }]
    return []


# ── logging / notification ───────────────────────────────────────────────────

LOG_TAG = "smc-cookie-refresh"


def unquote(v: str) -> str:
    """gpclient >= 3.0 prints COOKIE='<value>' / HOST='<value>' with literal
    shell-style quotes (the output is designed to be eval-ed). Strip them."""
    if len(v) >= 2 and v[0] == "'" and v[-1] == "'":
        return v[1:-1]
    return v


def log(msg: str) -> None:
    syslog.openlog(LOG_TAG, syslog.LOG_PID, syslog.LOG_DAEMON)
    syslog.syslog(syslog.LOG_INFO, msg)
    syslog.closelog()


def notify(pw, summary: str, body: str) -> None:
    """Send a desktop notification to the real user's session."""
    uid = pw.pw_uid
    dbus_addr = f"unix:path=/run/user/{uid}/bus"
    env = os.environ.copy()
    env["DBUS_SESSION_BUS_ADDRESS"] = dbus_addr
    env["DISPLAY"] = ":0"
    try:
        subprocess.run(
            ["sudo", "-u", pw.pw_name, "notify-send",
             "--urgency=normal", "--icon=network-vpn",
             summary, body],
            env=env, timeout=5, capture_output=True,
        )
    except Exception:
        pass  # notification is best-effort


# ── cookie refresh ───────────────────────────────────────────────────────────

def gpclient_path(config: dict, pw) -> str:
    """First existing candidate: config value, ~/.local/bin/gpclient-smc,
    gpclient on PATH, /usr/bin/gpclient."""
    candidates = [
        config.get("GPCLIENT_BIN", ""),
        os.path.join(pw.pw_dir, ".local", "bin", "gpclient-smc"),
        shutil.which("gpclient") or "",
        "/usr/bin/gpclient",
    ]
    for cand in candidates:
        if cand and os.path.isfile(cand):
            return cand
    return candidates[-1]


def get_fresh_cookie(config: dict, endpoint: dict, pw) -> tuple[str, str] | None:
    """
    Run gpclient --print-cookie as the real user.
    Returns (COOKIE, HOST) or None if the portal session has expired.
    """
    gpclient = gpclient_path(config, pw)
    cache = endpoint["cache"]
    portal = endpoint["portal"]
    browser = config.get("BROWSER", "chrome")
    gpauth = config.get("GP_AUTH_BIN", "").strip()

    # Check if cookie cache has valid data before attempting refresh.
    # If the cache is empty or the portal session has expired, skip
    # the gpclient call entirely — it would open a browser for
    # re-authentication, which is unwanted on manual disconnect.
    try:
        with open(cache) as f:
            cache_data = json.load(f)
        if not cache_data.get("auth_cookie", {}).get("userAuthCookie"):
            log("Cookie cache empty or invalid — skipping refresh (no browser auth)")
            return None
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        log("Cookie cache missing or corrupt — skipping refresh")
        return None

    cmd = ["sudo", "-u", pw.pw_name]
    # Force our gpauth (same tree as gpclient-smc): env vars set in this process
    # do not survive `sudo -u` (env_reset), so pass them via /usr/bin/env instead.
    if gpauth and os.path.isfile(gpauth):
        cmd += ["/usr/bin/env", f"GP_AUTH_BINARY={gpauth}"]
    cmd += [
        gpclient, "connect", portal,
        "--browser", browser,
        "--cookie-cache", cache,
        "--cookie-only",
    ]
    env = os.environ.copy()
    env["HOME"] = pw.pw_dir
    env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path=/run/user/{pw.pw_uid}/bus"

    try:
        result = subprocess.run(
            cmd, capture_output=True, text=True, timeout=30, env=env,
        )
    except subprocess.TimeoutExpired:
        log("gpclient-smc timed out — portal session may have expired")
        return None
    except Exception as e:
        log(f"gpclient-smc failed to start: {e}")
        return None

    cookie = host = ""
    for line in result.stdout.splitlines():
        if line.startswith("COOKIE="):
            cookie = unquote(line[len("COOKIE="):])
        elif line.startswith("HOST="):
            host = unquote(line[len("HOST="):])

    if not cookie.startswith("authcookie=") or not host:
        log(
            f"gpclient-smc returned no usable cookie "
            f"(exit={result.returncode}); portal session likely expired"
        )
        return None

    return cookie, host


# ── NM secret write ──────────────────────────────────────────────────────────

def write_nm_secrets(conn_name: str, cookie: str, host: str) -> None:
    client = NM.Client.new(None)
    conn   = client.get_connection_by_id(conn_name)
    if conn is None:
        log(f"NM connection '{conn_name}' not found — skipping secret write")
        return

    s_vpn = conn.get_setting_vpn()
    s_vpn.add_secret("cookie",  cookie)
    s_vpn.add_secret("gateway", host)
    s_vpn.add_secret("gwcert",  "")

    conn.update2(
        conn.to_dbus(NM.ConnectionSerializationFlags.ALL),
        NM.SettingsUpdate2Flags.TO_DISK,
        None, None, None,
    )
    ml = GLib.MainLoop()
    GLib.timeout_add(700, ml.quit)
    ml.run()


# ── main ─────────────────────────────────────────────────────────────────────

def main() -> None:
    if len(sys.argv) < 3:
        sys.exit(0)

    action    = sys.argv[2]
    conn_uuid = os.environ.get("CONNECTION_UUID", "")
    conn_id   = os.environ.get("CONNECTION_ID",   "")
    iface     = sys.argv[1]

    # Locate the config and resolve the real user
    config_path, config, pw = find_config()
    if pw is None:
        # No smc-gp-vpn config found for any logged-in user — not our VPN
        sys.exit(0)

    endpoints = parse_endpoints(config, pw.pw_dir)
    if not endpoints:
        sys.exit(0)

    # Only act when one of our configured endpoint connections goes down.
    # vpn-pre-down: NM waits for this — fires while the session is still alive,
    #   before logout.esp is called. Refreshing here ensures the cookie on disk
    #   is valid after reboot even when shutdown happens with VPN active.
    # vpn-down: kept as fallback for unexpected drops where pre-down did not run.
    endpoint = _endpoint_for_connection(endpoints, conn_id, conn_uuid)
    if endpoint is None:
        sys.exit(0)
    if action not in ("vpn-down", "vpn-pre-down"):
        sys.exit(0)

    conn_name = endpoint["conn_name"]

    # Gateway-mode endpoints authenticate directly against the gateway
    # (--as-gateway): CAS never issues a reusable portal session for them,
    # so a silent refresh cannot mint a cookie — it could only open a
    # browser on every disconnect. Skip; the next toggle-on fails visibly
    # and the user runs the widget's Authenticate button when needed.
    if endpoint.get("as_gateway"):
        log(f"[{endpoint['id']}] {conn_name} {action} on {iface} — "
            f"gateway-mode endpoint: no reusable portal session, "
            f"skipping refresh")
        sys.exit(0)

    log(f"[{endpoint['id']}] {conn_name} {action} on {iface} — refreshing gateway cookie")

    result = get_fresh_cookie(config, endpoint, pw)
    if result is None:
        log(f"Portal session expired — manual `smc-vpn-refresh` required")
        notify(
            pw,
            f"{conn_name} VPN — re-authentication required",
            "The portal session has expired. Use the VPN widget's "
            "Authenticate button (or run `smc-vpn-refresh`) to log in again.",
        )
        sys.exit(0)

    cookie, host = result
    write_nm_secrets(conn_name, cookie, host)
    log(f"Gateway cookie refreshed (len={len(cookie)}) — {conn_name} toggle ready")


def _get_uuid(conn_name: str) -> str:
    """Look up the UUID of a NM connection by name (best-effort)."""
    try:
        client = NM.Client.new(None)
        conn   = client.get_connection_by_id(conn_name)
        if conn:
            return conn.get_uuid()
    except Exception:
        pass
    return ""


def _endpoint_for_connection(endpoints: list[dict], conn_id: str, conn_uuid: str) -> dict | None:
    """Match a dispatcher event to one of our configured endpoints by
    connection id, falling back to a UUID lookup (id may have changed)."""
    for ep in endpoints:
        if conn_id == ep["conn_name"]:
            return ep
    if conn_uuid:
        for ep in endpoints:
            if conn_uuid and conn_uuid == _get_uuid(ep["conn_name"]):
                return ep
    return None


if __name__ == "__main__":
    main()
