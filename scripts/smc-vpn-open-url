#!/usr/bin/env python3
"""
smc-vpn-open-url — open the GlobalProtect CAS login URL in a configured
browser profile.

gpauth invokes this as `smc-vpn-open-url <URL>` when smc-vpn-refresh passes
`--browser <path-to-this-script>`. Which browser and profile to use come from
the environment smc-vpn-refresh sets on the gpclient process (it propagates
through gpauth to here — verified):

  SMC_VPN_BROWSER          chrome (default) | chromium
  SMC_VPN_BROWSER_PROFILE  profile dir key, display name or account email;
                           optional — empty means the browser's default
                           profile handling (previous behaviour)

The browser is started in its own session and this launcher exits right away,
so cancelling an authentication can never signal the browser window.

`--check <profile>` validates a profile without opening anything and prints
JSON {dir, name, email} — smc-vpn-refresh uses it to fail early on a typo'd
config, before the sign-in UI even starts.

Profile matching reads the browser's "Local State" and accepts the profile
directory key ("stagwell"), its display name ("stagwellglobal.com") or the
account email. An unknown or ambiguous profile exits 1 with an ERROR: line
listing the available ones.
"""

import json
import os
import subprocess
import sys

BROWSER_DIRS = {
    "chrome": os.path.expanduser("~/.config/google-chrome"),
    "chromium": os.path.expanduser("~/.config/chromium"),
}
BROWSER_BINS = {
    "chrome": ["google-chrome-stable", "google-chrome"],
    "chromium": ["chromium"],
}
BROWSER_LABELS = {"chrome": "Chrome", "chromium": "Chromium"}


def die(msg: str) -> None:
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(1)


def load_profiles(browser: str) -> dict:
    """{dir_key: {name, email}} from the browser's Local State."""
    base = BROWSER_DIRS.get(browser)
    if not base:
        die(f"Unsupported browser '{browser}' (supported: chrome, chromium)")
    path = os.path.join(base, "Local State")
    try:
        with open(path) as f:
            data = json.load(f)
        info = data["profile"]["info_cache"]
    except (OSError, ValueError, KeyError, TypeError):
        die(f"No browser profiles found for {browser} at {path}")
    profiles = {}
    for key, val in info.items():
        profiles[key] = {
            "name": str(val.get("name", "") or ""),
            "email": str(val.get("user_name", "") or ""),
        }
    return profiles


def resolve_profile(profiles: dict, spec: str) -> tuple[str, dict]:
    """Match a profile dir key, display name or account email."""
    want = spec.strip()
    if want in profiles:  # exact dir key first (case-sensitive)
        return want, profiles[want]
    lw = want.lower()
    hits = [k for k, v in profiles.items()
            if k.lower() == lw
            or (v["name"] and v["name"].lower() == lw)
            or (v["email"] and v["email"].lower() == lw)]
    if len(hits) == 1:
        return hits[0], profiles[hits[0]]
    listing = ", ".join(
        f"{k} ({v['name'] or 'no name'}{', ' + v['email'] if v['email'] else ''})"
        for k, v in profiles.items()
    ) or "<none>"
    if len(hits) > 1:
        die(f"Ambiguous browser profile '{spec}' matches {', '.join(hits)}. "
            f"Available: {listing}")
    die(f"Browser profile '{spec}' not found. Available: {listing}")


def main() -> None:
    args = sys.argv[1:]

    if args and args[0] == "--check":
        if len(args) < 2:
            die("usage: smc-vpn-open-url --check <profile>")
        browser = os.environ.get("SMC_VPN_BROWSER", "chrome").strip() or "chrome"
        profiles = load_profiles(browser)
        key, info = resolve_profile(profiles, args[1])
        print(json.dumps({"dir": key, "name": info["name"],
                          "email": info["email"], "browser": browser}))
        return

    if not args:
        die("usage: smc-vpn-open-url <URL>  (invoked by gpauth)")

    url = args[0]
    browser = os.environ.get("SMC_VPN_BROWSER", "chrome").strip() or "chrome"
    profile_spec = os.environ.get("SMC_VPN_BROWSER_PROFILE", "").strip()

    cmd = None
    for cand in BROWSER_BINS.get(browser, []):
        if any(os.path.isfile(os.path.join(p, cand)) for p in os.environ.get("PATH", "").split(os.pathsep)) \
                or os.path.isfile(f"/usr/bin/{cand}"):
            cmd = cand
            break
    if cmd is None:
        die(f"Browser binary for '{browser}' not found")

    argv = [cmd]
    if profile_spec:
        profiles = load_profiles(browser)
        key, _info = resolve_profile(profiles, profile_spec)
        argv.append(f"--profile-directory={key}")
        argv.append("--new-window")
    argv.append(url)

    # Own session, fire-and-forget: the browser outlives (and is immune to)
    # anything that happens to gpclient/gpauth, including Cancel.
    subprocess.Popen(argv, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    main()
